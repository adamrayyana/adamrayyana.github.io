---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchPalette from '../components/SearchPalette.astro';
import { siteConfig } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  type = 'website',
  image
} = Astro.props;
const pageTitle = title === siteConfig.title ? title : `${title} // ${siteConfig.name}`;
const siteUrl = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, siteUrl);
const imageUrl = image ? new URL(image, siteUrl) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#120d14" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href={new URL(`${import.meta.env.BASE_URL}rss.xml`, siteUrl)} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('kannrisha-theme');
        const preferred = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = saved || preferred;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="noise" aria-hidden="true"></div>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <SearchPalette />
  </body>
</html>
