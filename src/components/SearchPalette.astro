---
import { withBase } from '../lib/urls';
import { getPosts, postSlug } from '../lib/posts';

const fallbackIndex = (await getPosts()).map((post) => ({
  title: post.data.title,
  description: post.data.description,
  url: withBase(`/posts/${postSlug(post)}/`),
  searchText: [post.data.title, post.data.description, ...post.data.tags, post.body ?? ''].join(' ').toLowerCase()
}));
---

<dialog class="search-dialog" data-base={import.meta.env.BASE_URL} aria-label="Search notes">
  <div class="search-window">
    <div class="search-bar">
      <label class="search-input-wrap">
        <span class="sr-only">Search the site</span>
        <input type="search" autocomplete="off" placeholder="Search notes…" />
      </label>
      <button class="search-close" type="button" data-search-close aria-label="Close search">×</button>
    </div>
    <div class="search-results" aria-live="polite">
      <div class="search-empty">Start typing to search.</div>
    </div>
  </div>
</dialog>
<script is:inline type="application/json" data-search-fallback set:html={JSON.stringify(fallbackIndex).replace(/</g, '\\u003c')}></script>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.search-dialog');
  const input = dialog?.querySelector<HTMLInputElement>('input[type="search"]');
  const results = dialog?.querySelector<HTMLElement>('.search-results');
  const fallbackData = JSON.parse(document.querySelector<HTMLScriptElement>('[data-search-fallback]')?.textContent ?? '[]');
  const preferPagefind = import.meta.env.PROD;
  let pagefind: any;
  let selectedIndex = -1;

  const openSearch = () => {
    dialog?.showModal();
    requestAnimationFrame(() => input?.focus());
  };

  document.querySelectorAll('[data-search-open]').forEach((button) => button.addEventListener('click', openSearch));
  dialog?.querySelector('[data-search-close]')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog?.close();
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement;
    const isTyping = /INPUT|TEXTAREA|SELECT/.test(target.tagName) || target.isContentEditable;
    if ((event.key === '/' && !isTyping) || ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k')) {
      event.preventDefault();
      openSearch();
    }
  });

  input?.addEventListener('input', async () => {
    const query = input?.value.trim() ?? '';
    selectedIndex = -1;
    if (!results) return;
    if (!query.length) {
      results.innerHTML = '<div class="search-empty">Start typing to search.</div>';
      return;
    }

    results.innerHTML = '<div class="search-empty">Searching the stack…</div>';
    try {
      if (!preferPagefind) throw new Error('Use local fallback');
      if (!pagefind) {
        const base = dialog?.dataset.base ?? '/';
        pagefind = await import(/* @vite-ignore */ `${base}pagefind/pagefind.js`);
        await pagefind.init();
      }
      const response = await pagefind.search(query);
      const items = await Promise.all(response.results.slice(0, 8).map((result: any) => result.data()));
      if (!items.length) {
        results.innerHTML = `<div class="search-empty">No trace found for “${escapeHtml(query)}”.</div>`;
        return;
      }
      results.innerHTML = items.map((item: any, index: number) => `
        <a class="search-result" data-result-index="${index}" href="${item.url}">
          <strong>${item.meta?.title ?? 'Untitled'}</strong>
          <span>${item.excerpt ?? ''}</span>
        </a>`).join('');
    } catch {
      const normalized = query.toLowerCase();
      const items = fallbackData.filter((item: any) => item.searchText.includes(normalized)).slice(0, 8);
      if (!items.length) {
        results.innerHTML = `<div class="search-empty">No results for “${escapeHtml(query)}”.</div>`;
        return;
      }
      results.innerHTML = items.map((item: any, index: number) => `
        <a class="search-result" data-result-index="${index}" href="${item.url}">
          <strong>${escapeHtml(item.title)}</strong>
          <span>${escapeHtml(item.description)}</span>
        </a>`).join('');
    }
  });

  input?.addEventListener('keydown', (event) => {
    const links = [...(results?.querySelectorAll<HTMLAnchorElement>('.search-result') ?? [])];
    if (!links.length || !['ArrowDown', 'ArrowUp', 'Enter'].includes(event.key)) return;
    event.preventDefault();
    if (event.key === 'Enter' && selectedIndex >= 0) return links[selectedIndex].click();
    selectedIndex = event.key === 'ArrowDown'
      ? (selectedIndex + 1) % links.length
      : (selectedIndex - 1 + links.length) % links.length;
    links.forEach((link, index) => link.classList.toggle('is-selected', index === selectedIndex));
  });

  function escapeHtml(value: string) {
    return value.replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character]!);
  }
</script>
