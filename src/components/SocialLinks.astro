---
import { siteConfig } from '../config/site';
---

<nav class="social-links" aria-label="Social links">
  {siteConfig.social.map((social) => (
    <a
      href={social.href}
      aria-label={social.label}
      title={social.label}
      target={social.icon === 'email' ? undefined : '_blank'}
      rel={social.icon === 'email' ? undefined : 'me noreferrer'}
    >
      {social.icon === 'github' && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.57-.29-5.27-1.29-5.27-5.69 0-1.26.45-2.29 1.2-3.1-.12-.29-.52-1.47.11-3.06 0 0 .98-.31 3.16 1.18a10.96 10.96 0 0 1 5.75 0c2.19-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.77.11 3.06.75.81 1.2 1.84 1.2 3.1 0 4.41-2.71 5.4-5.29 5.68.42.36.79 1.06.79 2.15v3.18c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z" /></svg>
      )}
      {social.icon === 'linkedin' && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.34 7.65H1.78V22h3.56V7.65ZM3.56 2A2.06 2.06 0 1 0 3.56 6.12 2.06 2.06 0 0 0 3.56 2ZM22.22 13.27c0-4.32-2.3-6.33-5.38-6.33a4.65 4.65 0 0 0-4.2 2.31v-1.6H9.08V22h3.56v-7.1c0-1.87.36-3.68 2.68-3.68 2.28 0 2.31 2.14 2.31 3.8V22h3.56l1.03-8.73Z" /></svg>
      )}
      {social.icon === 'discord' && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.54 5.34A16.3 16.3 0 0 0 15.44 4l-.51 1.05a15.1 15.1 0 0 0-5.86 0L8.55 4a16.5 16.5 0 0 0-4.1 1.35C1.85 9.2 1.15 12.95 1.5 16.65a16.7 16.7 0 0 0 5.03 2.54l1.24-1.7a10.7 10.7 0 0 1-1.95-.94l.48-.37c3.77 1.75 7.86 1.75 11.58 0l.49.37c-.63.37-1.28.68-1.96.94l1.24 1.7a16.6 16.6 0 0 0 5.03-2.54c.42-4.29-.72-8-3.14-11.31ZM8.65 14.37c-1.14 0-2.07-1.04-2.07-2.31 0-1.28.91-2.32 2.07-2.32 1.17 0 2.1 1.05 2.08 2.32 0 1.27-.92 2.31-2.08 2.31Zm6.7 0c-1.14 0-2.07-1.04-2.07-2.31 0-1.28.91-2.32 2.07-2.32 1.17 0 2.1 1.05 2.08 2.32 0 1.27-.91 2.31-2.08 2.31Z" /></svg>
      )}
      {social.icon === 'email' && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h18a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm9 9L3.5 6.6V18h17V6.6L12 13Zm0-2.5L18 6H6l6 4.5Z" /></svg>
      )}
      <span class="sr-only">{social.label}</span>
    </a>
  ))}
</nav>
