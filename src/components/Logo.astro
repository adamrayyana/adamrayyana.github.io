---
import { withBase } from '../lib/urls';

interface Props {
  class?: string;
  label?: string;
  variant?: 'default' | 'header';
}

const { class: className, label, variant = 'default' } = Astro.props;
const logoUrl = withBase(variant === 'header' ? '/logo-header.svg' : '/logo.svg');
---

<span
  class:list={['site-logo', className]}
  style={`--logo-source: url("${logoUrl}")`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
></span>
